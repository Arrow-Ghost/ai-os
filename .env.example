# Copy to .env  --  .env is gitignored and is on the agent's forbidden-paths list.
# Secrets live here and ONLY here. Never put one in config/policy.yaml.

# One key:
GROQ_API_KEY=

# Or several, comma-separated. The brain rotates to the next one on a rate
# limit, which matters because Groq's free tier runs out mid-demo.
# GROQ_API_KEYS=gsk_first,gsk_second,gsk_third

# Add whatever your feature needs, and read it with ctx.secret("NAME"):
# GITHUB_TOKEN=
# TAVILY_API_KEY=          # if you add web.search
